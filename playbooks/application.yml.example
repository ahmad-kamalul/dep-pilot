---
- name: Deploy an approved application
  hosts: localhost
  connection: local
  gather_facts: false
  tasks:
    - name: Verify prerequisites
      ansible.builtin.assert:
        that: false
        fail_msg: Replace this template with application-specific prerequisites before enabling it.
