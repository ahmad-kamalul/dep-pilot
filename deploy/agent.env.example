Agent__MasterUrl=https://controller.example.com:7443
Agent__StateDirectory=/var/lib/dep-pilot
Agent__Hostname=linux-target-01
Agent__AnsibleExecutable=/opt/dep-pilot/ansible/bin/ansible-playbook
DEP_PILOT_BOOTSTRAP_TOKEN_FILE=/etc/dep-pilot/bootstrap-token.txt
DEP_PILOT_MINIO_PASSWORD_FILE=/etc/dep-pilot/minio-password.txt
# Use only for a private/demo CA; omit for a publicly trusted server certificate.
Agent__ServerCertificateFile=/etc/dep-pilot/master.crt
ANSIBLE_COLLECTIONS_PATH=/opt/dep-pilot/collections
ANSIBLE_HOME=/var/lib/dep-pilot/ansible
DOCKER_HOST=unix:///var/run/docker.sock
